# Public WPGraphQL endpoint; server-side use only. No WordPress password needed.
WORDPRESS_GRAPHQL_URL=https://cms.thesolemart.com/graphql

# Optional rollback: use the legacy guide fields instead of the imported ACF groups.
# WORDPRESS_GUIDE_FIELDS_SOURCE=legacy

# Optional server-only draft writer. Create the dedicated no-publish role first.
WORDPRESS_API_URL=https://cms.thesolemart.com/wp-json/wp/v2/
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Optional official Amazon Creators API. Empty credentials/tag disable live offers.
# Match the credential version and marketplace in your Creators API dashboard.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
